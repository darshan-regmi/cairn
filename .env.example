# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://cairn:cairn@localhost:5433/cairn"

# Firebase web config (Project settings -> Your apps -> Web app). These are
# public values; they identify the project to the Firebase JS SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK credentials (Project settings -> Service accounts ->
# Generate new private key). Either a path to the downloaded JSON file or the
# JSON itself. Keep it out of version control.
FIREBASE_SERVICE_ACCOUNT=".secrets/firebase-service-account.json"

# Whether the sign-up page accepts new accounts. Omit for open (a fresh
# checkout works out of the box); set to "false" to close registration once
# your own account exists.
ALLOW_SIGNUP="true"
