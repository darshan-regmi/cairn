# Copy this file to `.env` and fill in the blanks before running:
#
#   cp .env.selfhost.example .env
#   docker compose -f docker-compose.selfhost.yml up -d
#
# `docker compose` reads `.env` automatically. Every secret below is yours to
# generate — the app refuses to start if one is missing or too weak. It never
# calls out to Firebase.

# The Docker image to run. Replace the registry path with wherever you pulled
# the cairn image from.
CAIRN_IMAGE="ghcr.io/your-org/cairn:latest"

# Port the app is published on for your host. Put a reverse proxy in front of
# it for HTTPS (see SELF_HOSTING.md).
APP_PORT="3000"

# ---------------------------------------------------------------- database ---
# PostgreSQL runs in its own container from docker-compose.selfhost.yml. These
# three values create that database; the app is wired to it automatically.
POSTGRES_USER="cairn"
POSTGRES_PASSWORD=""
POSTGRES_DB="cairn"

# ---------------------------------------------------------------- security ---
# Signs session cookies and the verification/reset links. Anyone who knows this
# value can forge a session, so keep it secret and unique to this install.
# Generate one with:  openssl rand -base64 48
# At least 32 characters; the app exits at startup if it is shorter.
SESSION_SECRET=""

# ------------------------------------------------------------------- basics ---
# The public address of this install. Used to build the verification and
# password-reset links, so it must be the URL people actually visit
# (behind a reverse proxy that is your https:// name, not a local port).
APP_URL="http://localhost:3000"

# Whether the sign-up page accepts new accounts. Set to "false" to close
# registration once your own accounts exist. Invites still work when closed.
ALLOW_SIGNUP="true"

# -------------------------------------------------------------------- email ---
# Optional. Without it Cairn still works: verification and reset links are
# printed to the container log (`docker compose logs app`) instead of emailed,
# and new accounts are treated as verified so nobody is locked out.
# SMTP_HOST and SMTP_FROM are both required to switch email on.
SMTP_HOST=""
# 587 (STARTTLS) and 465 (implicit TLS) are the common choices.
SMTP_PORT="587"
# "true" when the port speaks TLS straight away (usually 465).
SMTP_SECURE="false"
# Leave blank for a server that needs no authentication.
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cairn <cairn@example.com>"
