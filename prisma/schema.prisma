generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SLIPPED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskSource {
  PLANNED
  MEETING
  QUESTION
  REVIEW
}

enum QuestionStatus {
  OPEN
  ADOPTED
  PARKED
  DROPPED
}

enum ReviewVerdict {
  ON_TRACK
  PARTLY_MET
  OFF_TRACK
}

enum EvidenceType {
  DEMO
  SCREENSHOT
  TEST_RESULT
  BENCHMARK
  COMMIT_OR_PR
  SUPERVISOR_FEEDBACK
}

// The role a person chooses at sign up. It describes who they are in general
// (a normal user or student running projects, or a supervisor invited to review
// one). It gates the research tools; per-project rights live on
// ProjectMember.role.
enum UserRole {
  NORMAL
  STUDENT
  SUPERVISOR
}

// Per-project rights. The owner has full control; a supervisor can read and
// comment only.
enum ProjectRole {
  OWNER
  SUPERVISOR
}

// Whether a project is still being worked on. A project is either in progress
// (shown on the dashboard) or complete (moved to the archive). Completing a
// project is the only way it reaches the archive; nothing is archived by hand.
enum ProjectStatus {
  IN_PROGRESS
  COMPLETE
}

// What a comment is attached to. targetId points at the row of that table.
enum CommentTarget {
  MILESTONE
  TASK
  MEETING
  REVIEW
  QUESTION
  EVIDENCE
}

// ---------- Models ----------

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  role                UserRole             @default(NORMAL)
  avatarUrl           String?
  timeZone            String?
  emailVerifiedAt     DateTime?
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  // Set when the owner marks supervisor comments as read on the dashboard.
  commentsReadAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         ProjectMember[]
  comments            Comment[]
  passwordResetTokens PasswordResetToken[]
}

model Project {
  id             String          @id @default(cuid())
  title          String
  goal           String?
  startDate      DateTime
  endDate        DateTime
  shareToken     String?         @unique
  shareExpiresAt DateTime?
  // Shown on the dashboard while IN_PROGRESS; COMPLETE moves it to the archive.
  status         ProjectStatus   @default(IN_PROGRESS)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  milestones     Milestone[]
  meetings       Meeting[]
  questions      Question[]
  comments       Comment[]
  invites        Invite[]
}

// Access is granted per project through a membership row. The owner has full
// control; a supervisor can read and comment. Every query is scoped through
// this table, never through a single owner column on Project.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  status           MilestoneStatus @default(PLANNED)
  plannedStart     DateTime
  plannedEnd       DateTime
  actualStart      DateTime?
  actualEnd        DateTime?
  commitRange      String?
  goal             String?
  scope            String?
  definitionOfDone String?
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tasks            Task[]
  meetings         Meeting[]
  questions        Question[]
  review           Review?
  evidence         Evidence[]
  deliverables     Deliverable[]

  @@unique([projectId, order])
  @@index([projectId, status])
}

model Task {
  id               String        @id @default(cuid())
  milestoneId      String
  milestone        Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title            String
  status           TaskStatus    @default(TODO)
  due              DateTime?
  priority         Priority      @default(MEDIUM)
  source           TaskSource    @default(PLANNED)
  commit           String?
  notes            String?
  order            Int           @default(0)
  sourceMeetingId  String?
  sourceMeeting    Meeting?      @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceQuestionId String?       @unique
  sourceQuestion   Question?     @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  meetingTasks     MeetingTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([milestoneId, status, order])
}

model Meeting {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  date            DateTime
  nextMeetingDate DateTime?
  itemsDiscussed  String?
  achievements    String?
  problems        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // One line per agreed action. Converting a line sets MeetingTask.taskId and
  // creates a Task that remembers this meeting via Task.sourceMeetingId.
  actionItems     MeetingTask[]
  tasks           Task[]

  @@index([projectId, date])
}

// A single agreed action from a meeting. taskId is set when the line has been
// turned into a kanban card.
model MeetingTask {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String
  taskId    String?  @unique
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model Question {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  status      QuestionStatus @default(OPEN)
  raisedAt    DateTime       @default(now())
  decidedAt   DateTime?
  context     String?
  ifWeDoIt    String?
  whatItCosts String?
  ifWeDont    String?
  decision    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  task        Task?

  @@index([projectId, status])
}

model Review {
  id           String        @id @default(cuid())
  milestoneId  String        @unique
  milestone    Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  date         DateTime
  verdict      ReviewVerdict
  askedFor     String?
  demonstrated String?
  promised     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Evidence {
  id           String       @id @default(cuid())
  milestoneId  String
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  type         EvidenceType
  url          String?
  whatItProves String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([milestoneId])
}

// A concrete output a milestone should produce. doneAt is set by ticking it off;
// url is an optional link to where the deliverable lives.
model Deliverable {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  doneAt      DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([milestoneId])
}

// A supervisor comment on one item, or the owner's reply. Feedback lives here
// rather than in a column so the student's own text stays the student's.
model Comment {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetType CommentTarget
  targetId   String
  body       String
  createdAt  DateTime      @default(now())
  editedAt   DateTime?

  @@index([projectId, targetType, targetId])
}

// An invitation for a supervisor to join one project. Accepting creates a
// ProjectMember with role SUPERVISOR.
model Invite {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([email])
}

// A single-use password reset link. Like invites, the raw token travels in the
// link only; the database keeps a SHA-256 hash so a leak cannot be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
